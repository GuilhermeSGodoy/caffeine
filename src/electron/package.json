{
  "name": "caffeine-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell do Caffeine — spawna o backend .NET e carrega a UI Angular",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.caffeine.app",
    "productName": "Caffeine",
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "directories": {
      "output": "release"
    }
  }
}
