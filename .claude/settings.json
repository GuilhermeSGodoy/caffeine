{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-main-commit.js",
            "statusMessage": "Verificando branch antes de git commit/push..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/validate-commit-message.js",
            "statusMessage": "Validando formato da mensagem de commit..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-compact-context.js",
            "statusMessage": "Reancorando estado do projeto após compactação..."
          }
        ]
      }
    ]
  }
}
